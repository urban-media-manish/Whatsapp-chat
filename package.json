{
  "name": "whatsapp-live-support-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Live Customer Support Platform inspired by WhatsApp Web, Intercom, Crisp, WATI, and Zendesk",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd client && npm run build",
    "start": "cd server && npm start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
